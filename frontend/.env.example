# Leave empty in development: Vite forwards /api to the backend (see vite.config.ts).
# Set only if the API is hosted on a different domain in production, e.g. https://api.example.com
VITE_API_BASE_URL=
# Error tracking (optional): DSN of the Sentry frontend project. Empty = Sentry is not even downloaded.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_RELEASE=
