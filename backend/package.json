{
  "name": "agriai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "create-coordinator": "tsx --env-file-if-exists=.env src/scripts/createCoordinator.ts",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "check-indexes": "tsx --env-file-if-exists=.env src/scripts/checkIndexes.ts",
    "prompts:snapshot": "tsx src/scripts/snapshotPrompts.ts",
    "eval": "tsx --env-file-if-exists=.env src/scripts/evalAi.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@sentry/node": "^11.9.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
