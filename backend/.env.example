# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Any Gemini Flash model that accepts images. Check Google AI Studio for the current free-tier model.
# (gemini-2.5-flash is no longer available to new users.)
GEMINI_MODEL=gemini-3.8-flash

# Tried in order when GEMINI_MODEL is busy ("model is experiencing high demand"), slow, or gives bad JSON.
# Comma-separated; leave empty for no fallback.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Seconds a model may take before trying the next one (default 45). 25 = faster fallback when busy.
GEMINI_ATTEMPT_TIMEOUT_SECONDS=25

# low = fast answers (a few seconds). Use "off" only for older models that don't support thinking levels.
GEMINI_THINKING_LEVEL=low

# Which AI provider to use. Only "gemini" exists today.
AI_PROVIDER=gemini

PORT=4000

# MongoDB for "मेरी जाँच" (diagnosis history). Optional: leave empty to run without history.
# With docker compose this is set automatically to the bundled MongoDB.
MONGO_URI=mongodb://localhost:27017/agriai

# Number of reverse proxies in front of the backend (0 = none). docker compose sets 1 (nginx).
TRUST_PROXY=0

# Frontend URL allowed by CORS (comma-separated for more than one)
CORS_ORIGIN=http://localhost:5173

# Web push (optional). Generate keys with: npx web-push generate-vapid-keys
# All three must be set to turn push on.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Mandi prices from data.gov.in Agmarknet (optional). Free key: https://data.gov.in → My Account → API key
DATA_GOV_API_KEY=

# --- Marketplace (Phase 3). Needs MONGO_URI (a replica set, see README) and JWT_SECRET. ---
# Signs the login cookie. At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
# Send the login cookie only over HTTPS. Default: on when NODE_ENV=production. Set false only for http testing.
COOKIE_SECURE=
# Our commission on completed orders in percent (2 to 5). Default 3.
COMMISSION_PERCENT=

# --- Phase 4: production ---
# development (default) | production | test. In production CORS_ORIGIN, MONGO_URI and JWT_SECRET are required.
NODE_ENV=
# fatal | error | warn | info (default) | debug
LOG_LEVEL=
# Error tracking (optional): DSN of the Sentry backend project. Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Listing photos: database (default, stored in MongoDB) or cloudinary (production, see DEPLOY.md).
STORAGE_PROVIDER=
# cloudinary://<api_key>:<api_secret>@<cloud_name>  (Cloudinary dashboard → API environment variable). Keep secret.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=
